# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv
*.egg-info/
dist/
build/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Data (don't commit large datasets)
data/
*.csv
*.parquet
*.h5
*.hdf5

# Models (too large for Git)
models/*.pkl
models/*.joblib
models/*.h5

# Outputs (generated files)
outputs/plots/*.png
outputs/plots/*.jpg
outputs/reports/*.pdf
outputs/logs/*.log

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Secrets
.env
*.key
credentials.json

# Exceptions (DO commit these)
!data/.gitkeep
!models/.gitkeep
!outputs/plots/.gitkeep
!outputs/reports/.gitkeep